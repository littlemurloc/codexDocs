{"id":"sh/0jatwfex","kind":"textbox","name":"rule-body-2","position":{"left":777,"top":461,"width":431,"height":63},"text":"每名人物只计入一次。\n个人升级与点亮分别记录。","style":{"fontSize":23,"typeface":"Microsoft YaHei","color":"#EDF4F8","alignment":"left"},"geometry":"rect","lineWidth":0},
